/**
 * secrets.h.example - copy to secrets.h and fill in. secrets.h is gitignored.
 *
 *   cp include/secrets.h.example include/secrets.h
 *
 * AWS IoT Core setup, once per device:
 *   1. Create a Thing, generate a certificate and key pair, activate it.
 *   2. Attach a policy allowing iot:Connect / iot:Publish / iot:Subscribe /
 *      iot:Receive on this thing's topics only.
 *   3. aws iot describe-endpoint --endpoint-type iot:Data-ATS   -> AWS_IOT_ENDPOINT
 *   4. Paste the three PEM blobs below exactly as issued, newlines included.
 *
 * The root CA is Amazon Root CA 1, the same for every account:
 *   https://www.amazontrust.com/repository/AmazonRootCA1.pem
 *
 * TLS will fail with a date error until SNTP has synced, which the firmware
 * waits for before its first connect attempt.
 */
#pragma once

// ---- WiFi -----------------------------------------------------------------
#define WIFI_SSID "your-ssid"
#define WIFI_PASSWORD "your-password"

// ---- Identity -------------------------------------------------------------
// Used as the MQTT client id and as the topic prefix, so it must match the
// Thing name your IoT policy is written against.
#define DEVICE_ID "iiot-gateway-01"

// ---- AWS IoT Core ---------------------------------------------------------
#define AWS_IOT_ENDPOINT "xxxxxxxxxxxxxx-ats.iot.eu-central-1.amazonaws.com"
#define AWS_IOT_PORT 8883

static const char AWS_ROOT_CA[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
paste Amazon Root CA 1 here
-----END CERTIFICATE-----
)EOF";

static const char AWS_DEVICE_CERT[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
paste this device's certificate here
-----END CERTIFICATE-----
)EOF";

static const char AWS_PRIVATE_KEY[] PROGMEM = R"EOF(
-----BEGIN RSA PRIVATE KEY-----
paste this device's private key here
-----END RSA PRIVATE KEY-----
)EOF";
